rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /lanterns/{lanternId} {
      allow read: if true;

      allow create: if request.resource.data.keys().hasOnly(['text', 'designId', 'createdAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 40
        && request.resource.data.designId in [
          'classic-red', 'nebula-purple', 'galaxy-blue', 'sakura-pink',
          'jade-green', 'aurora', 'silver-moon', 'sunset',
          'cosmic-gold', 'shooting-star', 'ufo', 'cosmic-rainbow'
        ]
        && request.resource.data.createdAt == request.time;

      // โคมประธาน — เนื้อหาคงที่ ไม่รับข้อความอิสระจากผู้ใช้ (หน้า /admin เท่านั้นที่เรียกใช้)
      allow create: if request.resource.data.keys().hasOnly(['text', 'subtitle', 'designId', 'variant', 'createdAt'])
        && request.resource.data.variant == 'chairman'
        && request.resource.data.designId == 'chairman-gold'
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 80
        && request.resource.data.subtitle is string
        && request.resource.data.subtitle.size() <= 80
        && request.resource.data.createdAt == request.time;

      // delete เปิดสาธารณะเพราะเว็บนี้ไม่มีระบบล็อกอิน (ปุ่มลบทั้งหมดอยู่บนจอใหญ่)
      allow delete: if true;
      allow update: if false;
    }
  }
}
